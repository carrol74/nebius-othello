# 复制为 backend/.env，填写实际资源；密钥只放在服务端。
# 两项可同时留空；此时对局、提示和分支可用，Nemotron 复盘讲解不可用。
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
TOKEN_FACTORY_MODEL_ID=
EDAX_EXECUTABLE=
EDAX_EVAL_FILE=
EDAX_VERSION=4.6
# 通用分析与复盘最低等级；对局提示按初/中/高使用 level4/8/10。
EDAX_LEVEL=8
# 新对局在网页选择初/中/高（level1/4/8）。此项仅保留旧对手配置兼容。
EDAX_OPPONENT_LEVEL=2
EDAX_TIMEOUT_SECONDS=60
DATABASE_PATH=runtime/nemothello.sqlite3
BACKEND_SERVICE_TOKEN=
TASK_LIMIT_PER_SESSION=3
TASK_QUEUE_LIMIT=16
REQUEST_LIMIT_PER_SESSION=300
REQUEST_LIMIT_GLOBAL=1200
REQUEST_LIMIT_WINDOW_SECONDS=60
