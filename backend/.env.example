# Copy to backend/.env and set actual resource paths. Keep keys on the server.
# Leave both Token Factory fields empty to use games, hints, and branches without Nemotron reviews.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Coaching uses tool calls. Super is suited to development; Ultra gives the strongest explanations.
TOKEN_FACTORY_MODEL_ID=
EDAX_EXECUTABLE=
EDAX_EVAL_FILE=
EDAX_VERSION=4.6
# General analysis and minimum review level; beginner/intermediate/advanced hints use levels 4/8/10.
EDAX_LEVEL=8
# Choose beginner/intermediate/advanced (levels 1/4/8) in the app. This setting supports older opponent configurations.
EDAX_OPPONENT_LEVEL=2
EDAX_TIMEOUT_SECONDS=60
DATABASE_PATH=runtime/nemothello.sqlite3
BACKEND_SERVICE_TOKEN=
TASK_LIMIT_PER_SESSION=3
TASK_QUEUE_LIMIT=16
REQUEST_LIMIT_PER_SESSION=300
REQUEST_LIMIT_GLOBAL=1200
REQUEST_LIMIT_WINDOW_SECONDS=60
